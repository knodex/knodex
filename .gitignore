node_modules
bin

# Web build artifacts embedded into the Go binary — exclude everything except
# the .gitkeep placeholder that satisfies //go:embed all:dist in clean checkouts.
server/internal/static/dist/*
!server/internal/static/dist/.gitkeep

# Test results (all automated test output)
test-results/

# QA overlay temporary files
.qa-overlays/
knodex-deadcode-analysis
server/knodex-dex

# Legacy QA directories (now unified in test-results/)
web/qa/
web/test/qa/

# Environment variables (secrets)
.env
.env.local

# Ephemeral development artifacts
*_VALIDATION.md
*SECURITY_AUDIT*.md
*-SECURITY-FIXES.md
DEADCODE_ANALYSIS.md
E2E-*-INTEGRATION.md
pr-description.md

# Helm chart dependencies (downloaded by helm dependency build)
deploy/charts/knodex/charts/
deploy/charts/knodex/Chart.lock
.helm-packages/

# MkDocs build output
site/

.env.qa

# Enterprise license private keys (public key is intentionally committed)
server/ee/license/license_key.pem

# Local dev artifacts
.DS_Store

.claude/.story-automator-active

# Native dev build output (air, make dev-server)
server/tmp/

# Local agent tooling — BMAD skill/command framework (installed per-developer, not product code)
.claude/skills/bmad-*/
.claude/commands/bmad-*

# Browser-automation debug artifacts (Playwright MCP console/page dumps)
.playwright-mcp/

# BMAD automator run artifacts (per-run state/logs, not product code)
_bmad-output/story-automator/
_bmad-output/implementation-artifacts/
_bmad-output/brainstorming/

# QA run reports (generated test output)
qa/reports/

# Claude Code runtime/personal config (machine-specific; use settings.local.json to share)
.claude/scheduled_tasks.lock
.claude/settings.json
